# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# YOLO / training artifacts
yolo/datasets/
yolo/weights/
yolo/runs/
yolo/*.pt
# prepare.py rewrites `path:` with this machine's folder on every run.
yolo/data.yaml
# ultralytics downloads start/AMP-check weights into the folder it runs from.
/*.pt
/weights/

# Per-board camera state: calibration and filter values differ on every board,
# and tracking them makes `git pull` fail once a board writes its own.
vision/calib_data/**
!vision/calib_data/.gitkeep
vision/orbbec_filters.json
# Per-board demo values students edit; update_board.sh must not reset them.
launcher/demo_settings.json

# Point clouds / local dumps
**/*.ply
**/runs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
